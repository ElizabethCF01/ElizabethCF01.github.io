---
import { Image } from "astro:assets";
import Portrait from "../assets/images/eli-hero-img-1.png";
import Character from "./Character.astro";
import { about, aboutStats } from "../data/cv";
---

<div
  data-section="about"
  class="content text-white relative z-10 w-full min-h-full flex bg-center bg-stone-900 bg-cover overflow-hidden"
>
  <div class="bg-static w-full h-full absolute top-0 left-0 pointer-events-none"></div>
  <div class="w-full relative p-6 tv-sm:p-10 text-white text-start">
    <h1
      class="font-mono font-bold text-xl tv-sm:text-2xl"
      data-animate="typewriter"
      data-text="> About me"
    >
      {">"} About me
    </h1>

    <div class="mt-5 flex flex-col tv-lg:flex-row tv-lg:items-center gap-6 tv-lg:gap-10">
      <div class="tv-lg:w-[58%]">
        {about.map((text, i) => (
          <p
            data-animate="scanline"
            class:list={[
              "font-normal text-[15px] tv-sm:text-base leading-relaxed",
              i > 0 && "mt-3",
              i === about.length - 1 && "opacity-70",
            ]}
          >
            {text}
          </p>
        ))}
      </div>
      <div class="relative w-3/5 max-w-[15rem] mx-auto tv-lg:w-[42%] tv-lg:max-w-[17rem]">
        <Image
          src={Portrait}
          alt="Portrait of Elizabeth Calzadilla"
          widths={[280, 560]}
          sizes="(min-width: 1024px) 20vw, 55vw"
          class="w-full -rotate-3"
          data-animate="broadcast"
        />
        <div class="absolute -right-[18%] -bottom-[12%] w-[62%]">
          <Character pose="crochet" />
        </div>
      </div>
    </div>

    <ul class="stats mt-6">
      {aboutStats.map((stat) => (
        <li class="stat" data-animate="channel-tune">
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  import {
    gsap,
    createCleanupTracker,
    addSignalTuneIn,
    addTypewriter,
    addScanlineReveal,
    addBroadcastSlideIn,
    addChannelTuneIn,
  } from "../lib/gsap-tv";

  document.addEventListener("astro:page-load", () => {
    const content = document.querySelector(".content") as HTMLElement;
    if (content?.dataset.section !== "about") return;
    const heading = content.querySelector("[data-animate='typewriter']") as HTMLElement;

    try {
      const tracker = createCleanupTracker();
      const paragraphs = Array.from(
        content.querySelectorAll("[data-animate='scanline']")
      ) as HTMLElement[];
      const portrait = content.querySelector("[data-animate='broadcast']") as HTMLElement;
      const stats = Array.from(
        content.querySelectorAll("[data-animate='channel-tune']")
      ) as HTMLElement[];

      const tl = gsap.timeline();
      tracker.add(tl);

      // 1. CRT power-on (~0.4s)
      addSignalTuneIn(tl, content);

      // 2. Typewriter heading (starts at 0.3s, overlaps with CRT end)
      addTypewriter(tl, heading, "> About me", "-=0.1", 0.8);

      // 3. Scanline reveal paragraphs (starts right after CRT finishes)
      addScanlineReveal(tl, paragraphs, "-=0.5", 0.15);

      // 4. Portrait slides in
      if (portrait) addBroadcastSlideIn(tl, portrait, "-=0.4", { x: 120, opacity: 0, scale: 0.9 });

      // 5. Stat cards
      addChannelTuneIn(tl, stats, "-=0.3", 0.12);

      document.addEventListener("astro:before-preparation", () => tracker.killAll(), { once: true });
    } catch (e) {
      console.error("GSAP About animation failed:", e);
      content.style.opacity = "1";
      content.style.transform = "none";
    }
  });
</script>

<style>
  .stats {
    display: grid;
    gap: 0.6rem;
    list-style: none;
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.8rem;
    background: #ffffff0f;
    border: 2px solid #e69635;
    border-radius: 8px;
  }
  .stat-value {
    flex-shrink: 0;
    min-width: 3.2rem;
    font-family: VT323, monospace;
    font-size: 2.5rem;
    line-height: 1;
    color: #ffb347;
  }
  .stat-label {
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  @container screen (min-width: 37.5rem) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
