---
import Character from "./Character.astro";
import { highlights, pitch, profile } from "../data/cv";
---

<div
  data-section="hero"
  class="content home text-white relative z-10 w-full min-h-full flex overflow-hidden"
>
  <div class="bg-static w-full h-full absolute top-0 left-0 pointer-events-none"></div>
  <div class="w-full relative p-6 tv-sm:p-10 flex flex-col justify-center text-start">
    <div class="flex flex-col tv-sm:flex-row tv-sm:items-center gap-5 tv-lg:gap-8">
      <div class="tv-sm:w-[58%]">
        <div data-animate="hero-name">
          <span
            class="font-mono font-bold text-xs tv-lg:text-sm tracking-widest glitch-text"
            data-glitch={`> ${profile.fullName}`}
          >
            {">"} {profile.fullName}
          </span>
        </div>
        <div data-animate="hero-title">
          <h1 class="mt-2 text-5xl tv-lg:text-[64px] leading-[1.05] font-bold glitch-title">{profile.role}</h1>
        </div>

        <p class="mt-4 text-[15px] tv-lg:text-base leading-relaxed" data-animate="channel-tune">
          {pitch}
        </p>

        <div class="mt-5 flex flex-wrap gap-3" data-animate="channel-tune">
          <a class="hero-cta primary" href="/experience">▶ Watch: Experience</a>
          <a class="hero-cta" href="/contact">Contact</a>
        </div>
      </div>

      <div class="w-3/4 max-w-[17rem] mx-auto tv-sm:w-[42%] tv-sm:max-w-none" data-animate="channel-tune">
        <Character pose="typing" class="scene" />
      </div>
    </div>

    <ul class="lower-thirds mt-6" data-animate="channel-tune">
      {highlights.map((item) => (
        <li class="lower-third">
          <span class="lt-title">{item.title}</span>
          <span class="lt-detail">{item.detail}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  import { gsap, createCleanupTracker, addSignalTuneIn, addChannelTuneIn } from "../lib/gsap-tv";

  document.addEventListener("astro:page-load", () => {
    const content = document.querySelector(".content") as HTMLElement;
    if (content?.dataset.section !== "hero") return;

    try {
      const tracker = createCleanupTracker();
      const nameWrapper = content.querySelector("[data-animate='hero-name']") as HTMLElement;
      const titleWrapper = content.querySelector("[data-animate='hero-title']") as HTMLElement;

      const tl = gsap.timeline();
      tracker.add(tl);

      // 1. CRT power-on
      addSignalTuneIn(tl, content);

      // 2. Name slides up
      tl.fromTo(nameWrapper, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, "+=0.05")
        .fromTo(titleWrapper, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, "-=0.2");

      // 3. Pitch, lower thirds and buttons
      const rest = Array.from(content.querySelectorAll("[data-animate='channel-tune']")) as HTMLElement[];
      addChannelTuneIn(tl, rest, "-=0.2", 0.12);

      document.addEventListener("astro:before-preparation", () => tracker.killAll(), { once: true });
    } catch (e) {
      console.error("GSAP Hero animation failed:", e);
      content.style.opacity = "1";
      content.style.transform = "none";
    }
  });
</script>

<style>
  .home {
    --gap-horizontal: 10px;
    --time-anim: 4s;
    --delay-anim: 2s;
    background: linear-gradient(#2b1a5a, #1a1036);
  }
  :global(.scene) {
    border-radius: 12px;
  }

  /* broadcast-style captions */
  .lower-thirds {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }
  .lower-third {
    display: flex;
    flex-direction: column;
    padding: 0.45rem 0.7rem;
    background: #0c0a1ed9;
    border-left: 5px solid #e69635;
    border-radius: 0 6px 6px 0;
  }
  .lt-title {
    font-weight: 700;
    line-height: 1.25;
  }
  .lt-detail {
    font-size: 0.8125rem;
    line-height: 1.35;
    opacity: 0.85;
  }
  @container screen (min-width: 37.5rem) {
    .lower-thirds {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-family: "Space Mono", monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: #fff;
    background: #0c0a1ed9;
    border: 2px solid #fff;
    border-radius: 8px;
    transition: transform 0.15s, background 0.15s, color 0.15s;
  }
  .hero-cta.primary {
    color: #1d0e01;
    background: #e69635;
    border-color: #1d0e01;
    box-shadow: 0 0 0 2px #e69635;
  }
  .hero-cta:hover {
    transform: translateY(-2px);
  }
  .hero-cta:not(.primary):hover {
    color: #1d0e01;
    background: #fff;
  }
  .hero-cta.primary:hover {
    background: #f2b465;
    box-shadow: 0 0 0 2px #f2b465;
  }
  .hero-cta:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 3px;
  }

  /* Text glitch */
  .glitch-text,
  .glitch-title {
    position: relative;
    animation-name: glitch-anim-text;
    animation-duration: var(--time-anim);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .glitch-text {
    animation-delay: calc(var(--delay-anim) + var(--time-anim) * 0.25);
  }
  .glitch-title {
    animation-delay: calc(var(--delay-anim) + var(--time-anim) * 0.2);
  }

  /* jitter and color split only: the text must stay readable in every frame */
  @keyframes glitch-anim-text {
    0%,
    2.4% {
      transform: translateX(calc(-0.4 * var(--gap-horizontal)));
      text-shadow:
        3px 0 #ff3b6b,
        -3px 0 #3bf0ff;
    }
    2.5%,
    4.9% {
      transform: translateX(calc(0.3 * var(--gap-horizontal)));
      text-shadow:
        -2px 0 #ff3b6b,
        2px 0 #3bf0ff;
    }
    5%,
    100% {
      transform: none;
      text-shadow: none;
    }
  }
</style>
