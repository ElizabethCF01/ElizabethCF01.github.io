    <g fill="#1d0e01" opacity="0.35">
      <rect x="14" y="35" width="3" height="13" /><rect x="131" y="35" width="3" height="13" />
      <rect x="22" y="22" width="3" height="13" /><rect x="123" y="22" width="3" height="13" />
      <rect x="10" y="9" width="3" height="13" /><rect x="119" y="9" width="3" height="13" />
    </g>
    <g font-family="Space Mono, monospace" font-size="8" font-weight="700" text-anchor="middle" letter-spacing="1.5">
