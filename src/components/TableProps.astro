      <path d="M34 108C20 80 12 56 10 30C24 54 32 78 40 106Z" fill="#5fa056" />
      <path d="M46 108C58 82 66 60 70 36C60 60 52 82 42 106Z" fill="#3f7a3e" />
      <path d="M40 106C30 70 28 40 36 8C44 40 48 70 44 106Z" fill="#4f8a4a" />
      <path d="M38 108C34 88 26 76 22 64C32 74 38 86 42 106Z" fill="#6db464" />
      <path d="M14 112H66L60 158H20Z" fill="#c96b4b" />
      <rect x="10" y="102" width="60" height="12" rx="3" fill="#d9825e" />
    </g>
    <path d="M37 96C35 70 35 44 37 20" stroke="#8fd081" stroke-width="2" fill="none" opacity="0.6" />
  </svg>
</div>

