<style>
  .prop {
    position: absolute;
    /* bottom edge rests on the table top, in front of the TV */
    bottom: calc(-1 * (var(--table-offset) + 0.7rem));
    z-index: 2;
    display: block;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
  }
  .prop svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* soft contact shadow on the table top. It's outside the svg, so it stays on the
     table when a prop lifts on hover. */
  .plant::before,
  .books::before,
  .vhs::before,
  .mug::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 4%;
    right: 4%;
    bottom: calc(var(--shadow-y, 0px) - 0.6cqi);
    height: 1.2cqi;
    background: radial-gradient(closest-side, rgb(29 14 1 / 0.45), rgb(29 14 1 / 0));
  }
  .mug::before {
    /* the mug's bottom is 4 of its 90 viewBox units above the svg's edge */
    --shadow-y: calc(var(--w) * 4 / 60);
    right: 22%;
  }

  /* plant and mug grow into the free wall beside the TV on wide windows.
     The cabinet is about 109cqi wide: cqi measures .tv without its padding. */
  .plant {
    --w: clamp(8.5cqi, calc((100vw - 109cqi) / 2 - 2.5cqi), 16cqi);
    left: calc(-1cqi - var(--w));
    width: var(--w);
  }
  .books {
    left: 4cqi;
    width: 15cqi;
  }
  .remote {
    left: 5cqi;
    width: 11.5cqi;
    /* lies on the top book */
    bottom: calc(-1 * (var(--table-offset) + 0.7rem) + 4.2cqi);
    transform: rotate(-5deg);
  }
  .vhs {
    right: 20cqi;
    width: 12cqi;
  }
  /* its left edge stays put, clear of the leg; it grows outwards past the cabinet */
  .mug {
    --w: clamp(5.4cqi, calc((100vw - 109cqi) / 2 + 5.5cqi), 9cqi);
    right: calc(6.9cqi - var(--w));
    width: var(--w);
  }

  /* interactive props lift on hover/focus and show a green tag */
  .remote,
  .vhs svg,
  .mug svg,
  .plant {
    cursor: pointer;
    transition: transform 0.2s;
  }
  .remote:hover,
  .remote:focus-visible {
    transform: rotate(-8deg) translateY(-0.5cqi);
  }
  .vhs:hover svg,
  .vhs:focus-visible svg {
    transform: translateY(-0.5cqi) rotate(1.5deg);
  }
  .mug:hover svg,
  .mug:focus-visible svg {
    transform: translateY(-0.5cqi) rotate(-3deg);
  }
  .remote:focus-visible,
  .vhs:focus-visible,
  .mug:focus-visible,
  .plant:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 4px;
    border-radius: 6px;
  }
  .prop-tip {
    position: absolute;
    bottom: calc(100% + 0.5cqi);
    left: 50%;
    padding: 0.1em 0.5em;
    font-family: VT323, monospace;
    font-size: max(1.5cqi, 17px);
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    color: #9dff8a;
    text-shadow: 0 0 6px #4cff3a99;
    background: #142012;
    border: 2px solid #1d0e01;
    border-radius: 6px;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .remote .prop-tip {
    transform: translate(-50%, 4px) rotate(5deg);
  }
  .remote:hover .prop-tip,
  .remote:focus-visible .prop-tip,
  .vhs:hover .prop-tip,
  .vhs:focus-visible .prop-tip,
  .plant:hover .prop-tip,
  .plant:focus-visible .prop-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* the mug can sit at the window's right edge: its tag grows leftwards over the TV */
  .mug .prop-tip {
    left: auto;
    right: 0;
    transform: translate(0, 4px);
  }
  .mug:hover .prop-tip,
  .mug:focus-visible .prop-tip {
    opacity: 1;
    transform: translate(0, 0);
  }
  .remote:hover .prop-tip,
  .remote:focus-visible .prop-tip {
    transform: translate(-50%, 0) rotate(8deg);
  }

  .steam path {
    opacity: 0;
    animation: steam 3s ease-in-out infinite;
  }
  .steam path:nth-child(2) {
    animation-delay: 1s;
  }
  .steam path:nth-child(3) {
    animation-delay: 2s;
  }
  @keyframes steam {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    40% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  /* mug hover: the middle wisp of steam turns into a rising heart */
  .heart {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .mug:hover .steam path:nth-child(2),
  .mug:focus-visible .steam path:nth-child(2) {
