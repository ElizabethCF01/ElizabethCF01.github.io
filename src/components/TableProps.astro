    <g fill="#8a8a8a" stroke="#000" stroke-width="1">
      <circle cx="34" cy="11" r="2.6" /><circle cx="43" cy="11" r="2.6" /><circle cx="52" cy="11" r="2.6" />
      <circle cx="34" cy="19.5" r="2.6" /><circle cx="43" cy="19.5" r="2.6" /><circle cx="52" cy="19.5" r="2.6" />
