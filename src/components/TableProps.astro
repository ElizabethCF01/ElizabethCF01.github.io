<!-- coffee mug with steam -->
<div class="prop mug" aria-hidden="true">
  <svg viewBox="0 0 60 90">
    <g class="steam" fill="none" stroke="#fefae0" stroke-width="3" stroke-linecap="round">
      <path d="M18 34C12 26 24 20 18 10" />
      <path d="M27 34C21 24 33 18 27 6" />
      <path d="M36 34C30 26 42 20 36 12" />
    </g>
    <path d="M44 48C58 48 58 74 44 74" fill="none" stroke="#000" stroke-width="8" />
    <path d="M44 48C58 48 58 74 44 74" fill="none" stroke="#e8e1d0" stroke-width="3.5" />
    <rect x="6" y="38" width="40" height="48" rx="6" fill="#e8e1d0" stroke="#000" stroke-width="2.5" />
    <rect x="7.5" y="56" width="37" height="9" fill="#d36604" />
    <rect x="10" y="42" width="5" height="38" rx="2.5" fill="#ffffff" opacity="0.55" />
  </svg>
</div>

<style>
  .prop {
    position: absolute;
    /* bottom edge rests on the table top, in front of the TV */
    bottom: calc(-1 * (var(--table-offset) + 0.7rem));
    z-index: 2;
    display: block;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
  }
  .prop svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* plant and mug grow into the free wall beside the TV on wide windows.
     The cabinet is about 109cqi wide: cqi measures .tv without its padding. */
  .plant {
    --w: clamp(8.5cqi, calc((100vw - 109cqi) / 2 - 2.5cqi), 16cqi);
    left: calc(-1cqi - var(--w));
    width: var(--w);
  }
  .books {
    left: 4cqi;
    width: 15cqi;
  }
  .remote {
    left: 5cqi;
    width: 11.5cqi;
    /* lies on the top book */
    bottom: calc(-1 * (var(--table-offset) + 0.7rem) + 4.2cqi);
    transform: rotate(-5deg);
  }
  .vhs {
    right: 20cqi;
    width: 12cqi;
  }
  /* its left edge stays put, clear of the leg; it grows outwards past the cabinet */
  .mug {
    --w: clamp(5.4cqi, calc((100vw - 109cqi) / 2 + 5.5cqi), 9cqi);
    right: calc(6.9cqi - var(--w));
    width: var(--w);
  }

  /* interactive props lift on hover/focus and show a green tag */
  .remote,
  .vhs {
    cursor: pointer;
    transition: transform 0.2s;
  }
  .remote:hover,
  .remote:focus-visible {
    transform: rotate(-8deg) translateY(-0.5cqi);
  }
  .vhs:hover,
  .vhs:focus-visible {
    transform: translateY(-0.5cqi) rotate(1.5deg);
  }
  .remote:focus-visible,
  .vhs:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 4px;
    border-radius: 6px;
  }
  .prop-tip {
    position: absolute;
    bottom: calc(100% + 0.5cqi);
    left: 50%;
    padding: 0.1em 0.5em;
    font-family: VT323, monospace;
    font-size: max(1.5cqi, 17px);
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    color: #9dff8a;
    text-shadow: 0 0 6px #4cff3a99;
    background: #142012;
    border: 2px solid #1d0e01;
    border-radius: 6px;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .remote .prop-tip {
    transform: translate(-50%, 4px) rotate(5deg);
  }
  .remote:hover .prop-tip,
  .remote:focus-visible .prop-tip,
  .vhs:hover .prop-tip,
  .vhs:focus-visible .prop-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .remote:hover .prop-tip,
  .remote:focus-visible .prop-tip {
    transform: translate(-50%, 0) rotate(8deg);
  }

  .steam path {
    opacity: 0;
    animation: steam 3s ease-in-out infinite;
  }
  .steam path:nth-child(2) {
    animation-delay: 1s;
  }
  .steam path:nth-child(3) {
    animation-delay: 2s;
  }
  @keyframes steam {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    40% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam path {
      animation: none;
      opacity: 0.6;
    }
  }

  /* not enough wall beside the TV for the plant */
  @media (max-aspect-ratio: 31/20) {
    .plant {
      display: none;
    }
  }
  /* pocket TV and short landscape: the table is only a thin strip */
  @media (max-width: 767px) and (orientation: portrait), (max-height: 500px) and (orientation: landscape) {
    .prop {
      display: none;
    }
  }
</style>
