---
import { Image } from "astro:assets";
import Uci from "../assets/images/uci.png";
import Freestyle from "../assets/images/freestyle-team.png";
import HarbourSpace from "../assets/images/harbour.space.png";
import { education, icpc } from "../data/cv";
---

<div
  data-section="education"
  class="content text-white relative z-10 w-full min-h-full flex bg-center bg-stone-900 rounded-[18px] border-black border bg-cover overflow-hidden"
>
  <div class="bg-static w-full h-full absolute top-0 left-0 pointer-events-none"></div>
  <div class="w-full relative p-6 tv-sm:p-10 text-white text-start">
    <div class="flex flex-col tv-lg:flex-row gap-8 tv-lg:gap-12">
      <div class="tv-lg:w-[55%]">
        <h1
          class="font-mono font-bold text-xl tv-sm:text-2xl"
          data-animate="typewriter"
          data-text="> Education"
        >
          {">"} Education
        </h1>

        {education.map((degree, i) => (
          <div class={i === 0 ? "mt-6" : "mt-5"} data-animate="channel-tune">
            <h2 class="font-semibold text-base">{degree.title} — {degree.school}</h2>
            <p class="text-sm opacity-70 mt-1">
              {[degree.focus, degree.place, degree.note].filter(Boolean).join(" · ")}
            </p>
          </div>
        ))}

        <div class="mt-5" data-animate="channel-tune">
          <h2 class="font-semibold text-base">{icpc.title} — {icpc.edition}</h2>
          <p class="text-sm opacity-70 mt-1">{icpc.place} · {icpc.team} competitor</p>
        </div>

        <p class="mt-5 font-normal text-sm leading-relaxed opacity-70" data-animate="channel-tune">
          Competitive programming background with a passion for continuous learning.
        </p>
      </div>
      <!-- Polaroids: stacked below the text on small screens, beside it on large ones -->
      <div class="relative w-full max-w-sm mx-auto h-80 tv-sm:h-[26rem] tv-lg:max-w-none tv-lg:w-[45%] tv-lg:h-[26rem] tv-lg:self-start">
        <Image
          src={Uci}
          alt="Universidad de las Ciencias Informáticas campus"
          widths={[260, 520]}
          sizes="(min-width: 1024px) 18vw, 50vw"
          class="absolute top-0 left-[2%] w-[58%] tv-lg:w-[78%] rotate-[4deg]"
          data-animate="polaroid"
        />
        <Image
          src={Freestyle}
          alt="Elizabeth with her UCI team at the ICPC World Finals in Luxor"
          widths={[240, 480]}
          sizes="(min-width: 1024px) 16vw, 45vw"
          class="absolute top-[22%] right-0 w-[48%] tv-lg:w-[64%] -rotate-[4deg]"
          data-animate="polaroid"
        />
        <Image
          src={HarbourSpace}
          alt="Harbour.Space University building"
          widths={[260, 520]}
          sizes="(min-width: 1024px) 18vw, 50vw"
          class="absolute bottom-0 left-[8%] w-[54%] tv-lg:w-[72%] rotate-[-8deg]"
          data-animate="polaroid"
        />
      </div>
    </div>
  </div>
</div>

<script>
  import {
    gsap,
    createCleanupTracker,
    addSignalTuneIn,
    addTypewriter,
    addChannelTuneIn,
    addPolaroidDrop,
  } from "../lib/gsap-tv";

  document.addEventListener("astro:page-load", () => {
    const content = document.querySelector(".content") as HTMLElement;
    if (content?.dataset.section !== "education") return;
    const heading = content.querySelector("[data-animate='typewriter']") as HTMLElement;

    try {
      const tracker = createCleanupTracker();
      const blocks = Array.from(
        content.querySelectorAll("[data-animate='channel-tune']")
      ) as HTMLElement[];
      const fadeP = content.querySelector("[data-animate='fade-in']") as HTMLElement;
      const images = Array.from(
        content.querySelectorAll("[data-animate='polaroid']")
      ) as HTMLElement[];

      const tl = gsap.timeline();
      tracker.add(tl);

      // 1. CRT power-on (~0.4s)
      addSignalTuneIn(tl, content);

      // 2. Typewriter heading
      addTypewriter(tl, heading, "> Education", "-=0.1", 0.7);

      // 3. Channel tune-in for education blocks
      addChannelTuneIn(tl, blocks, "-=0.4", 0.25);

      // 4. Fade in closing paragraph
      if (fadeP) {
        tl.to(fadeP, { opacity: 0.7, y: 0, duration: 0.3, ease: "power1.out" }, "-=0.2");
      }

      // 5. Polaroid drop for images
      addPolaroidDrop(tl, images, "-=0.3", 0.15);

      document.addEventListener("astro:before-preparation", () => tracker.killAll(), { once: true });
    } catch (e) {
      console.error("GSAP Education animation failed:", e);
      content.style.opacity = "1";
      content.style.transform = "none";
    }
  });
</script>

