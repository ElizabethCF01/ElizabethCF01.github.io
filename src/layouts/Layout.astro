---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import {
  channels,
  getChannel,
  getNextChannel,
  getPrevChannel,
} from "../data/channels";
import { links, profile } from "../data/cv";
import TableProps from "../components/TableProps.astro";

interface Props {
  // Used by pages outside the channel lineup (e.g. 404)
  title?: string;
}

const channel = getChannel(Astro.url.pathname);
const next = getNextChannel(Astro.url.pathname);
const prev = getPrevChannel(Astro.url.pathname);
const title = Astro.props.title ?? channel?.title ?? "No signal";
// Off the dial (pointing down) when the page isn't a channel
const knobAngle = channel?.knob ?? 180;
const channelLabel = channel ? `CH ${String(channel.number).padStart(2, "0")}` : "CH --";
const glow = channel?.glow ?? "235 235 235";

const isHome = channel?.path === "/";
const siteName = `${profile.name} · ${profile.role}`;
const pageTitle = isHome ? siteName : `${title} | ${siteName}`;
const description = channel?.description ?? profile.summary;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  jobTitle: profile.role,
  url: new URL("/", Astro.site),
  address: { "@type": "PostalAddress", addressLocality: "Barcelona", addressCountry: "ES" },
  sameAs: links.filter((link) => link.href.startsWith("http")).map((link) => link.href),
};
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Space+Mono:wght@400;700&family=VT323&family=Caveat:wght@700&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {channel ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`A retro orange TV showing ${profile.name}, ${profile.role}`} />
    {channel && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />}
    <ClientRouter />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#channel" class="skip-link">Skip to the show</a>
    <!--
      One markup, two devices:
      - big TV: desktop, tablet and any landscape screen
      - pocket TV: phones in portrait (max-width 767px), a Watchman-style handheld
    -->
    <div class="stage">
      <div class="tv" style={`--glow: ${glow}`}>
        <button type="button" class="antenna" aria-label="Wobble the antenna to clear the signal">
          <span class="mount"></span>
          <span class="rod rod-left"></span>
          <span class="rod rod-right"></span>
          <span class="dome"></span>
        </button>

        <div class="screen-frame">
          <div class="screen">
            <div class="screen-static" aria-hidden="true"></div>
            <main id="channel" class="screen-scroll" tabindex="0" aria-label={`${title} channel`}>
              <slot />
            </main>
            <button type="button" class="osd-more" aria-hidden="true" tabindex="-1">
              ▼ MORE
            </button>
            <div class="tune-static" aria-hidden="true"></div>
            <div class="osd" aria-hidden="true">
              <span class="osd-channel">{channelLabel}</span>
              <span class="osd-title">{title}</span>
            </div>
            <div class="osd osd-signal" aria-hidden="true">
              <span class="osd-title">Signal ▮▮▮▮▮</span>
            </div>
            <div class="crt-dot" aria-hidden="true"></div>
            <div class="crt-msg" aria-hidden="true">
              <p>&gt; oh. you found the off switch.</p>
              <p>&gt; most people just close the tab.</p>
              <p>&gt; flip me back on? i was just getting to the good part.</p>
            </div>
          </div>
        </div>

        <nav class="controls" aria-label="Channels">
          <div class="brand" aria-hidden="true">
            <span class="brand-name">Elivision</span>
            <span class="brand-sub">Solid state</span>
          </div>

          <a
            href={prev.path}
            class="pocket-btn prev"
            aria-label={`Previous channel: ${prev.title}`}
            aria-keyshortcuts="ArrowLeft"
          >
            <span aria-hidden="true">◀</span>
          </a>
          <button
            type="button"
            class="lcd"
            popovertarget="channel-guide"
            aria-label={`Channel guide. Now on ${channelLabel}, ${title}`}
          >
            <span class="lcd-channel" aria-hidden="true">{channelLabel}</span>
            <span class="lcd-title" aria-hidden="true">{title}</span>
          </button>
          <a
            href={next.path}
            class="pocket-btn next"
            aria-label={`Next channel: ${next.title}`}
            aria-keyshortcuts="ArrowRight"
          >
            <span aria-hidden="true">▶</span>
            <span class="tap-hint" aria-hidden="true">
              <span class="hint-text">tap me!</span>
              <svg class="hint-arrow" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 4c10 6 16 16 16 30" /><path d="M16 27l8 8 7-10" />
              </svg>
            </span>
          </a>

          <div class="knob-group channel-group">
            <div class="knob-dial">
              {channels.map((c) => (
                <span
                  class:list={["tick", { active: c === channel }]}
                  style={`--a: ${c.knob}deg`}
                  aria-hidden="true"
                >
                  {c.number}
                </span>
              ))}
              <a
                href={next.path}
                class="knob channel-knob"
                aria-label={`Next channel: ${next.title}`}
                aria-keyshortcuts="ArrowRight"
                draggable="false"
                data-stops={JSON.stringify(channels.map(({ path, knob }) => ({ path, knob })))}
              >
                <span class="knob-cap" style={`--angle: ${knobAngle}deg`}></span>
              </a>
              <span class="knob-tip" aria-hidden="true">Next: {next.title} ▸</span>
            </div>
            <span class="knob-hint" aria-hidden="true">
              <span class="hint-text">turn me!</span>
              <svg class="hint-arrow" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 10c12-4 22 2 28 16" /><path d="M24 24l8 4 2-9" />
              </svg>
            </span>
            <span class="knob-label" aria-hidden="true">Channel</span>
          </div>

          <div class="knob-group">
            <div class="knob-dial">
              <span class="tick active" style="--a: -60deg" aria-hidden="true">0</span>
              <span class="tick" style="--a: 60deg" aria-hidden="true">10</span>
              <button
                type="button"
                class="knob volume-knob"
                aria-label="Sound effects"
                aria-pressed="false"
              >
                <span class="knob-cap" style="--angle: -60deg"></span>
              </button>
            </div>
            <span class="knob-label" aria-hidden="true">Volume</span>
          </div>

          <button type="button" class="power-switch" aria-label="TV power" aria-pressed="true">
            <span class="switch-labels" aria-hidden="true"><span>Off</span><span>On</span></span>
            <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
          </button>
          <div class="speakers" aria-hidden="true"></div>
        </nav>

        <div class="wheel wheel-left" aria-hidden="true"></div>
        <div class="wheel wheel-right" aria-hidden="true"></div>
        <div class="table" aria-hidden="true"></div>
        <TableProps />
        <div class="legs" aria-hidden="true"><span></span><span></span></div>
      </div>
    </div>

    <div id="channel-guide" popover class="guide" role="dialog" aria-label="Channel guide">
      <p class="guide-title">TV Guide</p>
      <ol class="guide-list">
        {channels.map((c) => (
          <li>
            <a href={c.path} aria-current={c === channel ? "page" : undefined} autofocus={c === channel}>
              <span class="guide-ch">CH {String(c.number).padStart(2, "0")}</span>
              <span class="guide-name">{c.title}</span>
              {c === channel && <span class="guide-now">● on air</span>}
            </a>
          </li>
        ))}
      </ol>
      <p class="guide-keys guide-keys-keyboard">← → change channel · 1–{channels.length} tune in</p>
      <p class="guide-keys guide-keys-touch">Swipe the screen to change channel</p>
      <button type="button" class="guide-close" popovertarget="channel-guide" popovertargetaction="hide">
        Close ✕
      </button>
    </div>
  </body>
</html>

<style>
  /* hidden until a keyboard user tabs to it */
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 50;
    padding: 0.2rem 0.8rem;
    font-family: VT323, monospace;
    font-size: 1.4rem;
    color: #9dff8a;
    text-decoration: none;
    background: #142012;
    border: 2px solid #9dff8a;
    border-radius: 6px;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    outline: none;
    transform: none;
  }

  /* the room: 50s mint pinstripe wallpaper with a soft vignette toward the corners */
  html {
    background:
      radial-gradient(ellipse 75% 70% at 50% 42%, transparent 55%, #1f3d3438),
      url("/wallpaper.svg") center top / 48px 48px,
      #a9cfbf;
  }
  html,
  body {
    margin: 0;
    height: 100%;
    /* clip (not hidden): the table runs off-screen, and hidden would still let
       focus or popovers scroll the page down to it */
    overflow: clip;
  }

  .stage {
    box-sizing: border-box;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* room for the antenna above and the legs + table below */
    padding: 7.5rem 1rem 4.75rem;
  }

  /* ------------------------------------------------------------------ */
  /* TV body (big TV by default)                                         */
  /* ------------------------------------------------------------------ */
  .tv {
    --orange: #d36604;
    --orange-light: #e69635;
    --orange-deep: #b35603;
    --ink: #1d0e01;
    --wood: #7f5934;
    --wood-light: #b49577;
    --wood-dark: #513721;
    --bezel: #2b1a0d;
    --phosphor: #9dff8a;
    /* distance from the cabinet's bottom to the table top (leg height) */
    --table-offset: 1.8rem;

    container-type: inline-size;
    position: relative;
    box-sizing: border-box;
    width: min(1400px, 94vw, calc((100dvh - 12.75rem) * 1.6));
    aspect-ratio: 1.6;
    display: grid;
    grid-template-columns: 1fr 15cqi;
    gap: 2.4cqi;
    padding: 3cqi 2.6cqi 3.2cqi 3cqi;
    border-radius: 25px;
    background-color: var(--orange);
    border: 2px solid var(--ink);
    box-shadow:
      inset 1.2cqi 1.2cqi var(--orange-light),
      inset -0.6cqi -0.6cqi var(--orange-deep),
      /* light from the screen on the wall */
      0 0 6cqi 1cqi rgb(var(--glow) / calc(0.35 * var(--glow-on, 1))),
      0 0 22cqi 6cqi rgb(var(--glow) / calc(0.22 * var(--glow-on, 1)));
    transition: box-shadow 0.6s ease;
  }
  /* subtle grain on the plastic */
  .tv::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      repeating-radial-gradient(var(--orange) 0 0.0001%, #00000070 0 0.0002%) 50% 0/2500px 2500px,
      repeating-conic-gradient(var(--orange) 0 0.0001%, #00000070 0 0.0002%) 60% 60%/2500px 2500px;
    background-blend-mode: difference;
    opacity: 0.09;
  }

  /* Tablets in portrait: a taller set fills the screen better */
  @media (orientation: portrait) and (min-width: 768px) {
    .tv {
      aspect-ratio: 1.15;
      width: min(94vw, calc((100dvh - 12.75rem) * 1.15));
    }
  }

  /* ------------------------------------------------------------------ */
  /* Antenna                                                             */
  /* ------------------------------------------------------------------ */
  /*
    Antenna: a plinth (.mount) merges into the TV's top edge (it covers the TV's
    top border where it sits), the dome sits on it, and the rods come out of the
    dome, so the whole thing reads as one piece with the cabinet.
  */
  .antenna {
    padding: 0;
    cursor: pointer;
    background: none;
    border: 0;
    position: absolute;
    bottom: calc(100% - 2px);
    left: 50%;
    width: 7.5rem;
    height: 7rem;
    transform: translateX(-50%);
  }
  .mount {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 0.85rem;
    z-index: 2;
    /* same light orange as the cabinet's top highlight, so it looks molded in */
    background: var(--orange-light);
    border: 2px solid var(--ink);
    border-bottom: none;
    border-radius: 0.7rem 0.7rem 0 0;
    box-shadow: inset 0 0.2rem 0 #f2b465;
  }
  .dome {
    position: absolute;
    bottom: calc(0.85rem - 2px);
    left: calc(50% - 2.25rem);
    width: 4.5rem;
    height: 2.25rem;
    box-sizing: border-box;
    background-color: #f27405;
    border: 2px solid #000;
    border-bottom: none;
    border-radius: 4.5rem 4.5rem 0 0;
    box-shadow: inset -0.4rem 0 0 #c45c00;
    z-index: 1;
  }
  .dome::before {
    content: "";
    position: absolute;
    top: 0.45rem;
    left: 0.9rem;
    width: 1.4rem;
    height: 0.7rem;
    border-radius: 50%;
    background-color: #f69e50;
    transform: rotate(-20deg);
  }
  .rod {
    position: absolute;
    bottom: 1.8rem;
    left: calc(50% - 2px);
    width: 4px;
    height: 6rem;
    /* telescopic segments */
    background: linear-gradient(#5a5a5a 0 30%, #353535 30% 62%, #171717 62%);
    border-radius: 3px;
    transform-origin: bottom center;
  }
  .rod::after {
    content: "";
    position: absolute;
    top: -0.3rem;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    transform: translateX(-50%);
    border-radius: 50%;
    border: 2px solid #000;
    background-color: #b9b9b9;
  }
  .rod-left {
    --r: -28deg;
  }
  .rod-right {
    --r: 24deg;
    height: 5.2rem;
  }
  .rod {
    transform: rotate(var(--r));
    transition: transform 0.2s;
  }
  .antenna:hover .rod {
    transform: rotate(calc(var(--r) + 4deg));
  }
  .antenna:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 2px;
    border-radius: 8px;
  }
  .antenna.wobbling .rod {
    animation: rod-wobble 1.1s ease-out;
  }
  .antenna.wobbling .rod-right {
    animation-delay: 0.04s;
  }
  @keyframes rod-wobble {
    0%,
    100% {
      transform: rotate(var(--r));
    }
    12% {
      transform: rotate(calc(var(--r) + 22deg));
    }
    28% {
      transform: rotate(calc(var(--r) - 18deg));
    }
    45% {
      transform: rotate(calc(var(--r) + 11deg));
    }
    62% {
      transform: rotate(calc(var(--r) - 6deg));
    }
    80% {
      transform: rotate(calc(var(--r) + 2deg));
    }
  }

  /* ------------------------------------------------------------------ */
  /* Screen: recessed bezel + CRT glass                                  */
  /* ------------------------------------------------------------------ */
  .screen-frame {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 0;
    padding: 0.9cqi;
    background: var(--bezel);
    border: 2px solid var(--ink);
    border-radius: 24px;
    box-shadow:
      inset 0 0 0 2px #4a2e17,
      0 0 0 0.4cqi var(--orange-deep);
  }
  .screen {
    position: relative;
    box-sizing: border-box;
    height: 100%;
    display: flex;
    overflow: hidden;
    color: #252525;
    border: 2px solid #000;
    border-radius: 16px;
    background: #000;
  }
  /* static behind the channel, seen while it tunes in. Inset from the screen's edge:
     at the rounded corners it would leak through as a dotted line around the content */
  .screen-static {
    position: absolute;
    inset: 3px;
    border-radius: 11px;
    background:
      repeating-radial-gradient(#000 0 0.0001%, #fff 0 0.0002%) 50% 0/2500px 2500px,
      repeating-conic-gradient(#000 0 0.0001%, #fff 0 0.0002%) 60% 60%/2500px 2500px;
    background-blend-mode: difference;
    animation: static-drift 0.2s infinite alternate;
  }
  :global(html[data-tv-off]) .screen-static {
    display: none;
  }
  /* glass: vignette, faint scanlines and a glare highlight, above the content.
     Square on purpose, like the fade: .screen clips both, and a radius of their own
     would leave the content's corners uncovered */
  .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 30% at 22% 12%, #ffffff14, transparent 70%),
      repeating-linear-gradient(transparent 0 2px, #0000000d 2px 3px);
    box-shadow: inset 0 0 2.5cqi 0.4cqi #000000a6;
  }

  .screen-scroll {
    container: screen / inline-size;
    /* own stacking layer, so the fade, glass and MORE hint paint above sections */
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    border-radius: 14px;
    overscroll-behavior: contain;
    scrollbar-width: none;
    outline: none;
  }
  .screen-scroll::-webkit-scrollbar {
    display: none;
  }
  /* on the screen's edge: the scrolling section inside would paint over anything on it */
  .screen:has(.screen-scroll:focus-visible) {
    outline: 3px solid var(--phosphor);
    outline-offset: 2px;
  }

  /* fade at the edge where there's more content (set by the script below) */
  .screen::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    background: linear-gradient(transparent 70%, #0c0a09f2);
  }
  .screen[data-more-below]::before {
    opacity: 1;
  }

  .osd-more {
    position: absolute;
    right: 1.4cqi;
    bottom: 1.1cqi;
    z-index: 4;
    padding: 0.1em 0.5em;
    font-family: VT323, monospace;
    font-size: max(1.6cqi, 18px);
    letter-spacing: 0.08em;
    color: var(--phosphor);
    text-shadow: 0 0 6px #4cff3a99;
    background: #000000a0;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .screen[data-more-below] .osd-more {
    opacity: 1;
    visibility: visible;
    animation: osd-blink 1.2s steps(1) infinite;
  }
  @keyframes osd-blink {
    50% {
      color: #9dff8a66;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Controls panel (big TV: side column)                                */
  /* ------------------------------------------------------------------ */
  .controls {
    position: relative;
    z-index: 1;
    font-size: 1.15cqi;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.4em;
    padding: 1.4em 1em;
    background-color: var(--orange-light);
    border: 2px solid var(--ink);
    border-radius: 20px;
    box-shadow: inset -0.35em -0.35em 0 #d07f22;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-bottom: 0.7em;
    border-bottom: 2px solid var(--ink);
    color: var(--ink);
  }
  .brand-name {
    font-family: "DM Sans", sans-serif;
    font-size: 1.5em;
    font-weight: 700;
    font-style: italic;
    letter-spacing: 0.04em;
  }
  .brand-sub {
    font-family: "Space Mono", monospace;
    font-size: 0.7em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* channel readout */
  .lcd {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    height: 3.6em;
    margin: 0;
    padding: 0 0.6em;
    overflow: hidden;
    font-family: VT323, monospace;
    line-height: 1;
    text-transform: uppercase;
    color: var(--phosphor);
    text-shadow: 0 0 6px #4cff3a99;
    background: #142012;
    border: 2px solid var(--ink);
    border-radius: 8px;
    box-shadow: inset 0 2px 6px #000;
  }
  .lcd {
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .lcd:hover {
    box-shadow:
      inset 0 2px 6px #000,
      0 0 0 2px #9dff8a66;
  }
  .lcd:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 3px;
  }
  .lcd-channel {
    font-size: 1.7em;
  }
  .lcd-title {
    max-width: 100%;
    font-size: 1.15em;
    letter-spacing: 0.1em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.85;
  }

  /* knobs */
  .knob-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
  }
  .knob-dial {
    position: relative;
    padding: 1.5em;
  }
  .knob-label {
    font-family: "Space Mono", monospace;
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  /* channel numbers printed around the channel knob */
  .tick {
    position: absolute;
    top: 50%;
    left: 50%;
    font-family: "Space Mono", monospace;
    font-size: 0.95em;
    font-weight: 700;
    line-height: 1;
    color: #00000080;
    transform: translate(-50%, -50%) rotate(var(--a)) translateY(-3.6em) rotate(calc(-1 * var(--a)));
  }
  .tick.active {
    color: var(--ink);
  }
  .knob {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 5.4em;
    height: 5.4em;
    border-radius: 50%;
    /* ridged rim */
    background: repeating-conic-gradient(var(--wood) 0 7.5deg, var(--wood-dark) 7.5deg 15deg);
    border: 2px solid #000;
    box-shadow:
      -0.25em 0.25em 0 var(--wood-dark),
      -0.25em 0.25em 0 2px #000;
  }
  .knob-cap {
    position: absolute;
    inset: 13%;
    border-radius: 50%;
    background: var(--wood);
    border: 2px solid #000;
    box-shadow: inset 0.2em 0.2em 0 var(--wood-light);
    transform: rotate(var(--angle));
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* pointer */
  .knob-cap::before {
    content: "";
    position: absolute;
    top: 6%;
    left: calc(50% - 0.16em);
    width: 0.32em;
    height: 38%;
    border-radius: 0.2em;
    background: #fefae0;
    border: 1px solid #000;
  }
  .channel-knob {
    cursor: grab;
    touch-action: none;
    -webkit-user-drag: none;
    transition: transform 0.2s;
  }
  .channel-knob:hover,
  .channel-knob:focus-visible {
    transform: translateY(-3px);
  }
  .channel-knob:hover .knob-cap {
    filter: brightness(1.15);
  }
  .channel-knob.dragging {
    cursor: grabbing;
  }
  .channel-knob.dragging .knob-cap {
    transition: none;
  }

  /* "NEXT: ABOUT ▸" readout to the left of the knob */
  .knob-tip {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.4em);
    z-index: 5;
    padding: 0.15em 0.5em;
    font-family: VT323, monospace;
    font-size: 1.4em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--phosphor);
    text-shadow: 0 0 6px #4cff3a99;
    background: #142012;
    border: 2px solid var(--ink);
    border-radius: 6px;
    pointer-events: none;
    opacity: 0;
    transform: translate(6px, -50%);
    transition: opacity 0.2s, transform 0.2s;
  }
  .channel-knob:hover ~ .knob-tip,
  .channel-knob:focus-visible ~ .knob-tip {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /*
    First-visit hint: a hand-drawn bubble pointing at the channel control. The
    script sets html[data-hint] until the visitor changes channel once.
  */
  .channel-group {
    position: relative;
  }
  .knob-hint,
  .tap-hint {
    display: none;
    position: absolute;
    z-index: 6;
    align-items: center;
    gap: 0.1em;
    color: var(--ink);
    pointer-events: none;
  }
  :global(html[data-hint]) .knob-hint,
  :global(html[data-hint]) .tap-hint {
    display: flex;
  }
  /* hide the hint while the tooltip is up */
  .channel-group:has(.channel-knob:hover) .knob-hint {
    opacity: 0;
  }
  .knob-hint {
    top: 1.2em;
    right: calc(100% + 0.2em);
    font-size: 1.25em;
    animation: hint-wiggle 1.6s ease-in-out infinite;
  }
  .hint-text {
    font-family: Caveat, cursive;
    font-size: 1.9em;
    line-height: 1;
    white-space: nowrap;
    padding: 0.1em 0.45em 0.15em;
    background: #fefae0;
    border: 2px solid var(--ink);
    border-radius: 0.8em;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .hint-arrow {
    width: 2.6em;
    height: 2.6em;
    flex-shrink: 0;
  }
  @keyframes hint-wiggle {
    0%,
    100% {
      transform: rotate(-6deg);
    }
    50% {
      transform: rotate(3deg) translateX(-0.3em);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .knob-hint,
    .tap-hint {
      animation: none;
    }
  }
  .controls a:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 4px;
  }


  /* ------------------------------------------------------------------ */
  /* Channel change: static burst + on-screen display                    */
  /* ------------------------------------------------------------------ */
  .tune-static {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0;
    background:
      repeating-radial-gradient(#000 0 0.0001%, #fff 0 0.0002%) 50% 0/2500px 2500px,
      repeating-conic-gradient(#000 0 0.0001%, #fff 0 0.0002%) 60% 60%/2500px 2500px;
    background-blend-mode: difference;
    transition: opacity 0.18s ease-out;
  }
  .screen.tuning .tune-static {
    opacity: 1;
    transition: none;
    animation: static-drift 0.08s infinite alternate;
  }

  .osd {
    position: absolute;
    top: 1.6cqi;
    right: 2cqi;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: VT323, monospace;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--phosphor);
    text-shadow:
      0 0 8px #4cff3acc,
      2px 2px 0 #000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .osd-channel {
    font-size: max(4.2cqi, 40px);
  }
  .osd-title {
    font-size: max(2cqi, 22px);
    letter-spacing: 0.12em;
  }
  .screen.osd-on .osd:not(.osd-signal) {
    opacity: 1;
    transition: none;
  }

  /* volume knob: a sound on/off toggle */
  .volume-knob {
    padding: 0;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .volume-knob:hover,
  .volume-knob:focus-visible {
    transform: translateY(-3px);
  }
  .volume-knob:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 4px;
  }
  .knob-cap.no-anim {
    transition: none;
  }


  /* ------------------------------------------------------------------ */
  /* TV Guide (popover opened by the remote or the LCD readout)          */
  /* ------------------------------------------------------------------ */
  .guide {
    width: min(22rem, calc(100vw - 2rem));
    padding: 1.2rem 1.2rem 1rem;
    color: #9dff8a;
    font-family: VT323, monospace;
    text-transform: uppercase;
    text-shadow: 0 0 6px #4cff3a88;
    background:
      repeating-linear-gradient(transparent 0 2px, #00000033 2px 3px),
      #142012;
    border: 3px solid #1d0e01;
    border-radius: 16px;
    box-shadow:
      0 0 0 6px #d36604,
      0 0 0 8px #1d0e01,
      0 18px 40px #00000080;
  }
  .guide::backdrop {
    background: #0d1f1a99;
  }
  .guide-title {
    margin: 0 0 0.6rem;
    font-size: 2rem;
    letter-spacing: 0.15em;
    text-align: center;
    border-bottom: 2px dashed #9dff8a55;
    padding-bottom: 0.4rem;
  }
  .guide-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guide-list a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.35rem 0.6rem;
    font-size: 1.6rem;
    color: inherit;
    text-decoration: none;
    border-radius: 6px;
  }
  .guide-list a:hover,
  .guide-list a:focus-visible {
    color: #142012;
    text-shadow: none;
    background: #9dff8a;
    outline: none;
  }
  .guide-ch {
    opacity: 0.7;
  }
  .guide-now {
    margin-left: auto;
    font-size: 1.1rem;
    color: #ff8a65;
    text-shadow: 0 0 6px #ff6a3a88;
  }
  .guide-list a:hover .guide-now,
  .guide-list a:focus-visible .guide-now {
    color: #7a1f1f;
  }
  .guide-close {
    display: block;
    margin: 0.8rem auto 0;
    padding: 0.2rem 0.8rem;
    font: inherit;
    font-size: 1.2rem;
    color: inherit;
    background: transparent;
    border: 2px solid #9dff8a88;
    border-radius: 6px;
    cursor: pointer;
  }
  .guide-close:hover,
  .guide-close:focus-visible {
    background: #9dff8a22;
  }
  .guide-close:focus-visible {
    outline: 3px solid #9dff8a;
    outline-offset: 2px;
  }
  .guide-keys {
    margin: 0.6rem 0 0;
    font-size: 1.15rem;
    text-align: center;
    opacity: 0.75;
  }
  .guide-keys-touch {
    display: none;
  }
  @media (hover: none) {
    .guide-keys-keyboard {
      display: none;
    }
    .guide-keys-touch {
      display: block;
    }
  }


  /* slide power switch */
  .power-switch {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    font-size: 1.4em;
    padding: 0;
    cursor: pointer;
    background: none;
    border: 0;
  }
  .power-switch:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 3px;
    border-radius: 4px;
  }
  .switch-labels {
    display: flex;
    justify-content: space-between;
    font-family: "Space Mono", monospace;
    font-size: 0.6em;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
  }
  .switch-track {
    position: relative;
    display: block;
    width: 3.6em;
    height: 1.5em;
    background: var(--bezel);
    border: 2px solid var(--ink);
    border-radius: 1em;
    box-shadow: inset 0 2px 3px #000;
  }
  .switch-thumb {
    position: absolute;
    top: 0.12em;
    left: calc(100% - 1.75em);
    width: 1.6em;
    height: 1em;
    border-radius: 0.6em;
    background: #c0392b;
    border: 2px solid #000;
    box-shadow: inset 2px 2px 0 #e8806f;
    transition: left 0.15s;
  }
  .power-switch[aria-pressed="false"] .switch-thumb {
    left: 0.15em;
  }

  /* ------------------------------------------------------------------ */
  /* Antenna easter egg: interference, then a crystal-clear picture      */
  /* ------------------------------------------------------------------ */
  .screen.interference .tune-static {
    opacity: 0.55;
    transition: none;
    animation: static-drift 0.08s infinite alternate;
  }
  .osd-signal {
    opacity: 0;
  }
  .screen.signal-clear .osd-signal {
    opacity: 1;
    transition: none;
  }
  /* same corner as the channel label: only one shows at a time */
  .screen.signal-clear .osd:not(.osd-signal) {
    opacity: 0;
    transition: none;
  }
  .screen.signal-clear::after {
    background: none;
    box-shadow: none;
  }
  .screen.signal-clear :global(.bg-static) {
    opacity: 0;
  }
  .screen.signal-clear :global(.glitch-text),
  .screen.signal-clear :global(.glitch-title) {
    animation: none !important;
  }

  /* ------------------------------------------------------------------ */
  /* Power switch easter egg: CRT collapses to a dot, the room dims      */
  /* ------------------------------------------------------------------ */
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: #06141a;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  :global(html[data-tv-off]) {
    --glow-on: 0;
  }
  :global(html[data-tv-off]) body::after {
    opacity: 0.42;
  }
  :global(html[data-tv-off]) .lcd > * {
    opacity: 0;
  }
  :global(html[data-tv-off]) .screen {
    background: #050505;
    animation: none;
  }
  :global(html[data-tv-off]) .screen::before,
  :global(html[data-tv-off]) .osd-more,
  :global(html[data-tv-off]) .tune-static,
  :global(html[data-tv-off]) .osd {
    display: none;
  }
  :global(html[data-tv-off]) .screen-scroll {
    animation: crt-off 0.55s ease-in forwards;
  }
  .screen.powering-on .screen-scroll {
    animation: crt-on 0.5s ease-out;
  }
  @keyframes crt-off {
    0% {
      transform: scale(1, 1);
      filter: brightness(1);
    }
    55% {
      transform: scale(1, 0.006);
      filter: brightness(4);
    }
    100% {
      transform: scale(0, 0.006);
      filter: brightness(6);
      visibility: hidden;
    }
  }
  @keyframes crt-on {
    0% {
      transform: scale(0, 0.006);
      filter: brightness(6);
    }
    45% {
      transform: scale(1, 0.006);
      filter: brightness(4);
    }
    100% {
      transform: scale(1, 1);
      filter: brightness(1);
    }
  }
  .crt-dot {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 4;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 14px 6px #fff,
      0 0 40px 14px #bfe8ff;
    opacity: 0;
    pointer-events: none;
  }
  :global(html[data-tv-off]) .crt-dot {
    display: block;
    animation: crt-dot 1.5s 0.45s ease-out forwards;
  }
  @keyframes crt-dot {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(0.15);
    }
  }
  .crt-msg {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 4;
    padding: 0 8%;
    flex-direction: column;
    justify-content: center;
    gap: 0.5em;
    font-family: VT323, monospace;
    font-size: max(2.4cqi, 21px);
    line-height: 1.15;
    color: var(--phosphor);
    text-shadow: 0 0 8px #4cff3a99;
    pointer-events: none;
  }
  :global(html[data-tv-off]) .crt-msg {
    display: flex;
  }
  .crt-msg p {
    margin: 0;
    clip-path: inset(0 100% 0 0);
    animation: crt-type 0.9s steps(28) forwards;
  }
  .crt-msg p:nth-child(1) {
    animation-delay: 2s;
  }
  .crt-msg p:nth-child(2) {
    animation-delay: 3.2s;
  }
  .crt-msg p:nth-child(3) {
    animation-delay: 4.4s;
  }
  @keyframes crt-type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .antenna.wobbling .rod,
    .screen.powering-on .screen-scroll {
      animation: none;
    }
    :global(html[data-tv-off]) .screen-scroll {
      animation: none;
      visibility: hidden;
    }
    :global(html[data-tv-off]) .crt-dot {
      display: none;
    }
    .crt-msg p {
      clip-path: none;
      animation: none;
    }
  }

  /* speaker grille fills the bottom of the panel */
  .speakers {
    flex: 1;
    width: 100%;
    min-height: 3em;
    max-height: 12em;
    border: 2px solid var(--ink);
    border-radius: 0.8em;
    background:
      repeating-linear-gradient(var(--ink) 0 0.3em, transparent 0.3em 0.85em) 0 0.5em / 100% calc(100% - 1em) no-repeat,
      #d98a2e;
    box-shadow: inset 0.25em 0.25em 0 #f2b465;
  }

  /* pocket-only parts */
  .pocket-btn,
  .wheel {
    display: none;
  }

  /*
    Wooden table the TV stands on: top surface, front edge and grain. It's a
    child of .tv so it tracks the TV's position; it spans the full viewport width
    and runs off the bottom of the screen.
  */
  .table {
    position: absolute;
    top: calc(100% + var(--table-offset));
    left: 50%;
    width: 100vw;
    height: 100vh;
    transform: translateX(-50%);
    background:
      linear-gradient(var(--ink) 0 0) 0 0 / 100% 2px no-repeat,
      linear-gradient(#d39b5f, #b57d47) 0 2px / 100% 1rem no-repeat,
      linear-gradient(var(--ink) 0 0) 0 calc(1rem + 2px) / 100% 2px no-repeat,
      linear-gradient(#00000040, transparent) 0 calc(1rem + 4px) / 100% 1.2rem no-repeat,
      repeating-linear-gradient(
        178deg,
        transparent 0 13px,
        #00000017 13px 15px,
        transparent 15px 29px,
        #ffffff12 29px 30px
      ),
      #8a5a32;
  }
  /* contact shadow under the TV */
  .table::before {
    content: "";
    position: absolute;
    top: 0.1rem;
    left: 50%;
    width: 104cqi;
    height: 1rem;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, #00000055, transparent);
  }

  /* mid-century splayed legs */
  .legs {
    position: absolute;
    top: 100%;
    left: 9%;
    right: 9%;
    display: flex;
    justify-content: space-between;
  }
  .legs span {
    width: 1.1rem;
    height: 2.4rem;
    background: linear-gradient(90deg, var(--wood-light) 0 25%, var(--wood) 25%);
    border: 2px solid var(--ink);
    border-radius: 0 0 0.5rem 0.5rem;
    transform-origin: top center;
  }
  .legs span:first-child {
    transform: rotate(12deg);
  }
  .legs span:last-child {
    transform: rotate(-12deg);
  }

  /* Short landscape screens (phones on their side): drop antenna and legs */
  @media (max-height: 500px) and (orientation: landscape) {
    .stage {
      padding: 0.75rem 0.75rem 1.25rem;
    }
    .tv {
      --table-offset: 0px;
      width: min(94vw, calc((100dvh - 2rem) * 1.6));
    }
    .antenna,
    .legs {
      display: none;
    }
    .brand,
    .speakers {
      display: none;
    }
    .controls {
      justify-content: center;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Pocket TV: phones in portrait                                       */
  /* ------------------------------------------------------------------ */
  @media (max-width: 767px) and (orientation: portrait) {
    /* horizontal drags are channel swipes (see script); keep scroll and pinch zoom */
    .screen-scroll {
      touch-action: pan-y pinch-zoom;
    }

    .stage {
      padding: 5.75rem 0.75rem 2rem;
    }
    .tv {
      --table-offset: 0px;
      width: min(100%, 30rem);
      height: 100%;
      aspect-ratio: auto;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      gap: 4cqi;
      padding: 5cqi;
      border-radius: 28px;
      box-shadow:
        inset 2.5cqi 2.5cqi var(--orange-light),
        inset -1.2cqi -1.2cqi var(--orange-deep),
        0 0 8cqi 2cqi rgb(var(--glow) / calc(0.35 * var(--glow-on, 1))),
        0 0 24cqi 6cqi rgb(var(--glow) / calc(0.2 * var(--glow-on, 1)));
    }

    /* telescopic antenna on a swivel joint in the top-right corner */
    .antenna {
      left: auto;
      right: 12%;
      width: 1.8rem;
      height: 5.6rem;
      transform: none;
    }
    .mount {
      height: 0.75rem;
      border-radius: 0.4rem 0.4rem 0 0;
    }
    /* swivel ball */
    .mount::after {
      content: "";
      position: absolute;
      top: -0.45rem;
      left: calc(50% - 0.4rem);
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 50%;
      background: #6b6b6b;
      border: 2px solid #000;
      box-shadow: inset 2px 2px 0 #b9b9b9;
    }
    .dome,
    .rod-left {
      display: none;
    }
    .rod-right {
      bottom: 0.9rem;
      left: calc(50% - 2.5px);
      width: 5px;
      height: 4.6rem;
      --r: 16deg;
    }

    .screen-frame {
      padding: 2.2cqi;
      border-radius: 18px;
      box-shadow:
        inset 0 0 0 2px #4a2e17,
        3px 3px 0 var(--orange-light);
    }
    .screen {
      border-radius: 12px;
    }
    .screen-scroll {
      border-radius: 10px;
    }
    .screen::after {
      box-shadow: inset 0 0 6cqi 1cqi #000000a6;
    }
    .osd {
      top: 3cqi;
      right: 4cqi;
    }
    .osd-channel {
      font-size: 11cqi;
    }
    .osd-title {
      font-size: 5.5cqi;
    }
    .osd-more {
      right: 3cqi;
      bottom: 2.5cqi;
      font-size: 5cqi;
    }

    /* ribbed thumb wheels peeking out of the sides (tuning + volume) */
    .wheel {
      display: block;
      position: absolute;
      top: 34%;
      width: 9px;
      height: 15%;
      border: 2px solid var(--ink);
      background: repeating-linear-gradient(
        var(--wood) 0 3px,
        var(--wood-dark) 3px 5px
      );
    }
    .wheel-left {
      left: -9px;
      border-right: none;
      border-radius: 6px 0 0 6px;
    }
    .wheel-right {
      right: -9px;
      top: 48%;
      border-left: none;
      border-radius: 0 6px 6px 0;
    }

    .controls {
      font-size: 3.6cqi;
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        "brand brand brand"
        "prev lcd next"
        "power . grille";
      align-items: center;
      row-gap: 0.9em;
      column-gap: 0.9em;
      padding: 0.9em 1.1em 1.1em;
      border-radius: 18px;
    }
    .knob-group,
    .legs {
      display: none;
    }

    .brand {
      grid-area: brand;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      padding-bottom: 0.5em;
    }
    .brand-name {
      font-size: 1.25em;
    }
    .brand-sub {
      font-size: 0.6em;
      letter-spacing: 0.12em;
    }
    .brand-sub::after {
      content: " · Pocket TV";
    }

    .lcd {
      grid-area: lcd;
      height: 3.2em;
    }
    .lcd-channel {
      font-size: 1.5em;
    }
    .lcd-title {
      font-size: 1.1em;
    }

    .pocket-btn {
      display: grid;
      place-items: center;
      width: 3.6em;
      height: 3.2em;
      color: #fefae0;
      text-decoration: none;
      border-radius: 12px;
      background-color: var(--wood);
      border: 2px solid #000;
      box-shadow:
        inset 3px 3px 0 var(--wood-light),
        0 4px 0 #000;
      transition: transform 0.08s, box-shadow 0.08s;
    }
    .pocket-btn span {
      font-size: 1.3em;
    }
    .pocket-btn:active {
      transform: translateY(3px);
      box-shadow:
        inset 3px 3px 0 var(--wood-light),
        0 1px 0 #000;
    }
    .prev {
      grid-area: prev;
    }
    .next {
      grid-area: next;
      position: relative;
    }
    .tap-hint {
      right: -0.2em;
      bottom: calc(100% + 0.1em);
      flex-direction: column;
      align-items: flex-end;
      font-size: 0.75em;
      color: var(--ink);
      transform-origin: bottom right;
      animation: hint-bob 1.4s ease-in-out infinite;
    }
    .tap-hint .hint-arrow {
      width: 2.2em;
      height: 2.2em;
      margin-right: 0.6em;
      color: #fefae0;
      filter: drop-shadow(1px 1px 0 var(--ink)) drop-shadow(-1px -1px 0 var(--ink));
    }
    @keyframes hint-bob {
      0%,
      100% {
        transform: rotate(-4deg) translateY(0);
      }
      50% {
        transform: rotate(2deg) translateY(-0.35em);
      }
    }

    .power-switch {
      grid-area: power;
      font-size: 1em;
    }

    /* round speaker with a hole grid */
    .speakers {
      grid-area: grille;
      flex: none;
      width: 4.4em;
      height: 4.4em;
      min-height: 0;
      border-radius: 50%;
      background:
        radial-gradient(circle, var(--ink) 34%, transparent 38%) center / 0.62em 0.62em,
        #d98a2e;
      box-shadow:
        inset 3px 3px 0 #f2b465,
        2px 2px 0 var(--wood-dark);
    }
  }
</style>
<script>
  import { navigate } from "astro:transitions/client";

  // Changing channel again while a change is finishing can fire page-load twice for
  // the same page, and every handler would run twice: GSAP from() tweens would stick at
  // their start, listeners would double up. Capture listeners run first, so this
  // stops the repeat before any other handler sees it, whatever order scripts load in.
  const loadedBodies = new WeakSet<HTMLElement>();
  document.addEventListener(
    "astro:page-load",
    (e) => {
      if (loadedBodies.has(document.body)) e.stopImmediatePropagation();
      loadedBodies.add(document.body);
    },
    { capture: true }
  );

  // The swap is so fast that the second click of a double click lands on the new page's
  // link and would skip a channel. The router ignores clicks that are already prevented.
  const CLICK_COOLDOWN = 400;
  let lastChannelClick = -CLICK_COOLDOWN;
  document.addEventListener(
    "click",
    (e) => {
      if (!(e.target as Element).closest?.(".channel-knob, .pocket-btn")) return;
      if (e.timeStamp - lastChannelClick < CLICK_COOLDOWN) e.preventDefault();
      else lastChannelClick = e.timeStamp;
    },
    { capture: true }
  );

  // First-visit "turn me!" hint, until the visitor changes channel once.
  // Storage can be blocked, so also remember it for this session in memory.
  const TUNED_KEY = "elivision:tuned";
  let tuned = false;
  try {
    tuned = localStorage.getItem(TUNED_KEY) === "1";
  } catch {}

  document.addEventListener("astro:page-load", () => {
    document.documentElement.toggleAttribute("data-hint", !tuned);
  });
  document.addEventListener("astro:before-preparation", () => {
    tuned = true;
    try {
      localStorage.setItem(TUNED_KEY, "1");
    } catch {}
    document.documentElement.removeAttribute("data-hint");
  });

  // Drag the channel knob to turn it: it snaps to the nearest channel number.
  // A plain click still follows the link to the next channel.
  document.addEventListener("astro:page-load", () => {
    const knob = document.querySelector(".channel-knob") as HTMLAnchorElement | null;
    const cap = knob?.querySelector(".knob-cap") as HTMLElement | null;
    if (!knob || !cap) return;

    const stops: { path: string; knob: number }[] = JSON.parse(knob.dataset.stops ?? "[]");
    const startAngle = parseFloat(cap.style.getPropertyValue("--angle")) || 0;
    const normalize = (path: string) => (path.length > 1 ? path.replace(/\/$/, "") : path);
    let dragging = false;
    let turned = false;
    let pressX = 0;
    let pressY = 0;

    const angleAt = (e: PointerEvent) => {
      const r = knob.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      const deg = (Math.atan2(dx, -dy) * 180) / Math.PI;
      return Math.max(-80, Math.min(80, deg));
    };
    const setAngle = (deg: number) => cap.style.setProperty("--angle", `${deg}deg`);

    knob.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      dragging = true;
      turned = false;
      pressX = e.clientX;
      pressY = e.clientY;
      knob.setPointerCapture(e.pointerId);
    });
    knob.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      // The angle comes from the knob's center, so a hand tremor during a click can point
      // anywhere: it only counts as a turn once the pointer has really traveled
      if (!turned && Math.hypot(e.clientX - pressX, e.clientY - pressY) < 8) return;
      turned = true;
      knob.classList.add("dragging");
      setAngle(angleAt(e));
    });
    knob.addEventListener("pointerup", (e) => {
      if (!dragging) return;
      dragging = false;
      knob.classList.remove("dragging");
      if (!turned || !stops.length) return;
      const deg = angleAt(e);
      const nearest = stops.reduce((best, s) =>
        Math.abs(s.knob - deg) < Math.abs(best.knob - deg) ? s : best
      );
      setAngle(nearest.knob);
      if (nearest.path !== normalize(location.pathname)) navigate(nearest.path);
    });
    knob.addEventListener("pointercancel", () => {
      dragging = false;
      knob.classList.remove("dragging");
      setAngle(startAngle);
    });
    // A turn ends with a click event too; don't also follow the link
    knob.addEventListener("click", (e) => {
      if (turned) {
        e.preventDefault();
        turned = false;
      }
    });
  });

  // Channel change: static over the old screen while the next page loads, then a
  // short burst on the new one and the on-screen display (CH 03 / EDUCATION).
  // Optional sound (clunk + static hiss) is generated with Web Audio, off by default.
  const SOUND_KEY = "elivision:sound";
  let soundOn = false;
  try {
    soundOn = localStorage.getItem(SOUND_KEY) === "1";
  } catch {}
  let audio: AudioContext | null = null;
  let changingChannel = false;
  const reducedMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  function playTuneSound() {
    if (!soundOn) return;
    audio ??= new AudioContext();
    const t = audio.currentTime;

    // knob clunk: a short falling thump
    const thump = audio.createOscillator();
    const thumpGain = audio.createGain();
    thump.frequency.setValueAtTime(150, t);
    thump.frequency.exponentialRampToValueAtTime(45, t + 0.09);
    thumpGain.gain.setValueAtTime(0.45, t);
    thumpGain.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
    thump.connect(thumpGain).connect(audio.destination);
    thump.start(t);
    thump.stop(t + 0.13);

    // static hiss
    const length = Math.floor(audio.sampleRate * 0.5);
    const buffer = audio.createBuffer(1, length, audio.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < length; i++) data[i] = Math.random() * 2 - 1;
    const noise = audio.createBufferSource();
    noise.buffer = buffer;
    const filter = audio.createBiquadFilter();
    filter.type = "highpass";
    filter.frequency.value = 900;
    const noiseGain = audio.createGain();
    noiseGain.gain.setValueAtTime(0.0001, t);
    noiseGain.gain.exponentialRampToValueAtTime(0.12, t + 0.06);
    noiseGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.5);
    noise.connect(filter).connect(noiseGain).connect(audio.destination);
    noise.start(t + 0.04);
  }

  document.addEventListener("astro:before-preparation", () => {
    const guide = document.getElementById("channel-guide");
    if (guide?.matches(":popover-open")) guide.hidePopover();
    changingChannel = true;
    playTuneSound();
    if (!reducedMotion()) document.querySelector(".screen")?.classList.add("tuning");
  });

  document.addEventListener("astro:page-load", () => {
    const screen = document.querySelector(".screen") as HTMLElement | null;
    if (!screen || !changingChannel) return;
    changingChannel = false;

    if (!reducedMotion()) {
      screen.classList.add("tuning");
      setTimeout(() => screen.classList.remove("tuning"), 260);
    }
    screen.classList.add("osd-on");
    setTimeout(() => screen.classList.remove("osd-on"), 2000);
  });

  // Keyboard remote: ← → change channel, 1-9 tune in directly, ↑ ↓ scroll the screen
  // from anywhere. Registered once: this script isn't re-run by page swaps.
  document.addEventListener("keydown", (e) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    const target = e.target as HTMLElement;
    if (target.isContentEditable || target.matches?.("input, textarea, select")) return;

    const guide = document.getElementById("channel-guide");
    const guideOpen = guide?.matches(":popover-open");
    const go = (href?: string) => {
      if (!href) return;
      e.preventDefault();
      if (!e.repeat) navigate(href);
    };

    if (e.key === "ArrowRight") return go(document.querySelector<HTMLAnchorElement>(".pocket-btn.next")?.href);
    if (e.key === "ArrowLeft") return go(document.querySelector<HTMLAnchorElement>(".pocket-btn.prev")?.href);

    if (/^[1-9]$/.test(e.key)) {
      const links = document.querySelectorAll<HTMLAnchorElement>(".guide-list a");
      const link = links[Number(e.key) - 1];
      if (link && link.getAttribute("aria-current") !== "page") go(link.href);
      return;
    }

    if (e.key !== "ArrowUp" && e.key !== "ArrowDown" && e.key !== "PageUp" && e.key !== "PageDown") return;
    const sign = e.key === "ArrowUp" || e.key === "PageUp" ? -1 : 1;

    // In the open guide, up and down walk the list
    if (guideOpen) {
      const links = Array.from(guide!.querySelectorAll<HTMLAnchorElement>(".guide-list a"));
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      links[at < 0 ? 0 : (at + sign + links.length) % links.length]?.focus();
      e.preventDefault();
      return;
    }

    // Focus inside the screen already scrolls natively
    const scroller = document.querySelector(".screen-scroll") as HTMLElement | null;
    if (!scroller || scroller.contains(target)) return;
    e.preventDefault();
    const page = e.key === "PageUp" || e.key === "PageDown";
    scroller.scrollBy({
      top: sign * (page ? scroller.clientHeight * 0.8 : 80),
      behavior: page && !reducedMotion() ? "smooth" : "auto",
    });
  });

  // Pocket TV: swipe the screen sideways to change channel (left = next, like a page).
  // Vertical drags stay scrolls: the browser takes them and sends pointercancel.
  const pocketTv = matchMedia("(max-width: 767px) and (orientation: portrait)");
  let swipe: { id: number; x: number; y: number; at: number } | null = null;
  document.addEventListener("pointerdown", (e) => {
    swipe = null;
    if (e.pointerType !== "touch" || !e.isPrimary || !pocketTv.matches) return;
    if (!(e.target as HTMLElement).closest?.(".screen-scroll")) return;
    swipe = { id: e.pointerId, x: e.clientX, y: e.clientY, at: e.timeStamp };
  });
  document.addEventListener("pointercancel", () => {
    swipe = null;
  });
  document.addEventListener("pointerup", (e) => {
    if (!swipe || e.pointerId !== swipe.id) return;
    const dx = e.clientX - swipe.x;
    const dy = e.clientY - swipe.y;
    const quick = e.timeStamp - swipe.at < 800;
    swipe = null;
    if (!quick || Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
    const link = document.querySelector<HTMLAnchorElement>(dx < 0 ? ".pocket-btn.next" : ".pocket-btn.prev");
    if (link) navigate(link.href);
  });

  // Skip link: move focus into the screen (the router would only scroll to the hash)
  document.addEventListener("astro:page-load", () => {
    document.querySelector(".skip-link")?.addEventListener("click", (e) => {
      e.preventDefault();
      (document.querySelector(".screen-scroll") as HTMLElement | null)?.focus();
    });
  });

  // Volume knob toggles sound effects
  document.addEventListener("astro:page-load", () => {
    const knob = document.querySelector(".volume-knob") as HTMLButtonElement | null;
    const cap = knob?.querySelector(".knob-cap") as HTMLElement | null;
    const ticks = knob?.parentElement?.querySelectorAll(".tick");
    if (!knob || !cap) return;

    const render = (animate: boolean) => {
      cap.classList.toggle("no-anim", !animate);
      cap.style.setProperty("--angle", soundOn ? "60deg" : "-60deg");
      knob.setAttribute("aria-pressed", String(soundOn));
      ticks?.forEach((tick, i) => tick.classList.toggle("active", (i === 1) === soundOn));
      if (!animate) requestAnimationFrame(() => cap.classList.remove("no-anim"));
    };
    render(false);

    knob.addEventListener("click", () => {
      soundOn = !soundOn;
      try {
        localStorage.setItem(SOUND_KEY, soundOn ? "1" : "0");
      } catch {}
      render(true);
      if (soundOn) {
        audio ??= new AudioContext();
        audio.resume();
      }
    });
  });

  function playTone(from: number, to: number, seconds: number, volume: number, type: OscillatorType) {
    if (!soundOn) return;
    audio ??= new AudioContext();
    const t = audio.currentTime;
    const osc = audio.createOscillator();
    const gain = audio.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(from, t);
    osc.frequency.exponentialRampToValueAtTime(to, t + seconds);
    gain.gain.setValueAtTime(volume, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + seconds);
    osc.connect(gain).connect(audio.destination);
    osc.start(t);
    osc.stop(t + seconds);
  }

  // Easter egg: power switch. The state isn't remembered, so a reload or a channel
  // change always brings the TV back on (the swap replaces the <html> attributes).
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector(".power-switch") as HTMLButtonElement | null;
    const screen = document.querySelector(".screen") as HTMLElement | null;
    if (!button || !screen) return;

    button.addEventListener("click", () => {
      const turnOff = button.getAttribute("aria-pressed") === "true";
      button.setAttribute("aria-pressed", String(!turnOff));
      document.documentElement.toggleAttribute("data-tv-off", turnOff);
      if (turnOff) {
        playTone(2400, 80, 0.6, 0.08, "sine");
      } else {
        playTone(80, 1800, 0.4, 0.06, "sine");
        screen.classList.add("powering-on");
        setTimeout(() => screen.classList.remove("powering-on"), 520);
      }
    });
  });
  document.addEventListener("astro:before-preparation", () => {
    document.documentElement.removeAttribute("data-tv-off");
  });

  // Easter egg: wobble the antenna. A burst of interference, then a clear picture
  // (no noise, scanlines or glitch) for a few seconds.
  document.addEventListener("astro:page-load", () => {
    const antenna = document.querySelector(".antenna") as HTMLButtonElement | null;
    const screen = document.querySelector(".screen") as HTMLElement | null;
    if (!antenna || !screen) return;
    let clearTimer: ReturnType<typeof setTimeout> | undefined;

    antenna.addEventListener("click", () => {
      antenna.classList.remove("wobbling");
      void antenna.offsetWidth; // restart the animation on repeat clicks
      antenna.classList.add("wobbling");
      playTone(520, 180, 0.5, 0.1, "triangle");
      if (document.documentElement.hasAttribute("data-tv-off")) return;

      clearTimeout(clearTimer);
      screen.classList.remove("signal-clear");
      const clear = () => {
        screen.classList.remove("interference");
        screen.classList.add("signal-clear");
        clearTimer = setTimeout(() => screen.classList.remove("signal-clear"), 5000);
      };
      // No flash of static for reduced motion, only the clear picture
      if (reducedMotion()) return clear();
      screen.classList.add("interference");
      setTimeout(clear, 450);
    });
    antenna.addEventListener("animationend", () => antenna.classList.remove("wobbling"));
  });

  // Failsafe: if GSAP animations don't run within 2s, force content visible
  document.addEventListener("astro:page-load", () => {
    const content = document.querySelector(".content") as HTMLElement;
    if (!content) return;

    const failsafe = setTimeout(() => {
      content.style.opacity = "1";
      content.style.transform = "none";
      content.style.filter = "none";
    }, 2000);

    // GSAP scripts can clear this via the global
    (window as any).__gsapFailsafe = failsafe;
  });

  // Scroll hint: no visible scrollbar; the screen fades at the bottom and shows
  // a blinking "▼ MORE" while there is content below.
  document.addEventListener("astro:page-load", () => {
    const screen = document.querySelector(".screen") as HTMLElement | null;
    const scroller = document.querySelector(".screen-scroll") as HTMLElement | null;
    const more = document.querySelector(".osd-more") as HTMLElement | null;
    if (!screen || !scroller) return;

    const update = () => {
      const below = scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop > 8;
      screen.toggleAttribute("data-more-below", below);
    };

    scroller.addEventListener("scroll", update, { passive: true });
    more?.addEventListener("click", () => {
      scroller.scrollBy({ top: scroller.clientHeight * 0.8, behavior: reducedMotion() ? "auto" : "smooth" });
    });

    // Content height changes while sections animate in and images load
    const observer = new ResizeObserver(update);
    observer.observe(scroller);
    if (scroller.firstElementChild) observer.observe(scroller.firstElementChild);
    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });

    update();
  });
</script>
