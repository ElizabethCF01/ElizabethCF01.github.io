---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { getChannel, getNextChannel, getPrevChannel } from "../data/channels";
import { profile } from "../data/cv";

interface Props {
  // Used by pages outside the channel lineup (e.g. 404)
  title?: string;
}

const channel = getChannel(Astro.url.pathname);
const next = getNextChannel(Astro.url.pathname);
const prev = getPrevChannel(Astro.url.pathname);
const title = Astro.props.title ?? channel?.title ?? "No signal";
const knobAngle = channel?.knob ?? 0;
const channelLabel = channel ? `CH ${String(channel.number).padStart(2, "0")}` : "CH --";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Space+Mono:wght@400;700&family=VT323&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={profile.summary} />
    <ClientRouter />
    <title>{title} | {profile.name} · {profile.role}</title>
  </head>
  <body>
    <!--
      One markup, two devices:
      - big TV: desktop, tablet and any landscape screen
      - pocket TV: phones in portrait (max-width 767px), a Watchman-style handheld
    -->
    <main class="stage">
      <div class="tv">
        <div class="antenna" aria-hidden="true">
          <div class="rod rod-left"></div>
          <div class="rod rod-right"></div>
          <div class="dome"></div>
        </div>

        <svg class="curve" viewBox="0 0 189.929 189.929" aria-hidden="true">
          <path
            d="M70.343,70.343c-30.554,30.553-44.806,72.7-39.102,115.635l-29.738,3.951C-5.442,137.659,11.917,86.34,49.129,49.13
        C86.34,11.918,137.664-5.445,189.928,1.502l-3.95,29.738C143.041,25.54,100.895,39.789,70.343,70.343z"
          ></path>
        </svg>

        <div class="screen-frame">
          <div class="screen">
            <div class="screen-scroll">
              <slot />
            </div>
          </div>
        </div>

        <nav class="controls" aria-label="Channels">
          <div class="brand" aria-hidden="true">
            <span class="brand-name">Elivision</span>
            <span class="brand-sub">Solid state · Pocket TV</span>
          </div>
          <a
            href={prev.path}
            class="pocket-btn prev"
            aria-label={`Previous channel: ${prev.title}`}
          >
            <span aria-hidden="true">◀</span>
          </a>
          <a
            href={next.path}
            class="knob channel-knob"
            aria-label={`Next channel: ${next.title}`}
          >
            <span class="knob-indicator" style={`--angle: ${knobAngle}deg`}></span>
          </a>
          <p class="lcd">
            <span class="lcd-channel">{channelLabel}</span>
            <span class="lcd-title">{title}</span>
          </p>
          <a
            href={next.path}
            class="pocket-btn next"
            aria-label={`Next channel: ${next.title}`}
          >
            <span aria-hidden="true">▶</span>
          </a>
          <div class="knob volume-knob" aria-hidden="true">
            <span class="knob-indicator" style="--angle: -45deg"></span>
          </div>
          <div class="power-switch" aria-hidden="true">
            <span class="switch-labels"><span>Off</span><span>On</span></span>
            <span class="switch-track"><span class="switch-thumb"></span></span>
          </div>
          <div class="speakers" aria-hidden="true">
            <div class="dots"><span></span><span></span><span></span></div>
            <div class="bar"></div>
            <div class="bar"></div>
          </div>
        </nav>

        <div class="wheel wheel-left" aria-hidden="true"></div>
        <div class="wheel wheel-right" aria-hidden="true"></div>
        <div class="vents" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="legs" aria-hidden="true"><span></span><span></span></div>
      </div>
    </main>
  </body>
</html>

<style>
  html {
    --size: 80px;
    --color: #fefae0;

    --l: var(--color) 20%, #0000 0;
    --bg: 35%, #d1c0b644 0 45%, var(--color) 0;
    background:
      linear-gradient(45deg, var(--l) 45%, var(--color) 0 70%, #db777700 0),
      linear-gradient(-45deg, var(--l) var(--bg) 70%, #0000 0),
      linear-gradient(45deg, var(--color) var(--bg));
    background-size: var(--size) var(--size);
  }
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  .stage {
    box-sizing: border-box;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* room for the antenna above and the legs below */
    padding: 6.5rem 1rem 2.5rem;
  }

  /* ------------------------------------------------------------------ */
  /* TV body (big TV by default)                                         */
  /* ------------------------------------------------------------------ */
  .tv {
    --orange: #d36604;
    --orange-light: #e69635;
    --ink: #1d0e01;
    --wood: #7f5934;
    --wood-light: #b49577;
    --wood-dark: #513721;

    container-type: inline-size;
    position: relative;
    box-sizing: border-box;
    width: min(1400px, 94vw, calc((100dvh - 9.5rem) * 1.6));
    aspect-ratio: 1.6;
    display: grid;
    grid-template-columns: 1fr 14cqi;
    gap: 2.4cqi;
    padding: 3cqi 2.6cqi 3.4cqi 3cqi;
    border-radius: 25px;
    background-color: var(--orange);
    border: 2px solid var(--ink);
    box-shadow: inset 1.2cqi 1.2cqi var(--orange-light);
  }
  /* subtle grain on the plastic */
  .tv::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      repeating-radial-gradient(var(--orange) 0 0.0001%, #00000070 0 0.0002%) 50% 0/2500px 2500px,
      repeating-conic-gradient(var(--orange) 0 0.0001%, #00000070 0 0.0002%) 60% 60%/2500px 2500px;
    background-blend-mode: difference;
    opacity: 0.09;
  }

  /* Tablets in portrait: a taller set fills the screen better */
  @media (orientation: portrait) and (min-width: 768px) {
    .tv {
      aspect-ratio: 1.15;
      width: min(94vw, calc((100dvh - 9.5rem) * 1.15));
    }
  }

  .curve {
    position: absolute;
    top: 1.2cqi;
    left: 1.2cqi;
    width: 1.3cqi;
    height: 1.3cqi;
    z-index: 1;
  }

  /* ------------------------------------------------------------------ */
  /* Antenna                                                             */
  /* ------------------------------------------------------------------ */
  .antenna {
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 4.5rem;
    height: 6rem;
    transform: translateX(-50%);
  }
  .dome {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 4.5rem;
    height: 2.25rem;
    box-sizing: border-box;
    background-color: #f27405;
    border: 2px solid #000;
    border-bottom: none;
    border-radius: 4.5rem 4.5rem 0 0;
    z-index: 1;
  }
  .dome::before {
    content: "";
    position: absolute;
    top: 0.45rem;
    left: 0.9rem;
    width: 1.4rem;
    height: 0.7rem;
    border-radius: 50%;
    background-color: #f69e50;
    transform: rotate(-20deg);
  }
  .rod {
    position: absolute;
    bottom: 1rem;
    left: calc(50% - 1.5px);
    width: 3px;
    height: 6rem;
    background: #171717;
    border-radius: 3px;
    transform-origin: bottom center;
  }
  .rod::after {
    content: "";
    position: absolute;
    top: -0.3rem;
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    transform: translateX(-50%);
    border-radius: 50%;
    border: 2px solid #000;
    background-color: #979797;
  }
  .rod-left {
    transform: rotate(-28deg);
  }
  .rod-right {
    height: 5.2rem;
    transform: rotate(24deg);
  }

  /* ------------------------------------------------------------------ */
  /* Screen                                                              */
  /* ------------------------------------------------------------------ */
  .screen-frame {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 0;
    border-radius: 20px;
    box-shadow: 3.5px 3.5px 0 var(--orange-light);
  }
  .screen {
    position: relative;
    box-sizing: border-box;
    height: 100%;
    display: flex;
    overflow: hidden;
    color: #252525;
    border: 2px solid var(--ink);
    border-radius: 20px;
    background:
      repeating-radial-gradient(#000 0 0.0001%, #fff 0 0.0002%) 50% 0/2500px 2500px,
      repeating-conic-gradient(#000 0 0.0001%, #fff 0 0.0002%) 60% 60%/2500px 2500px;
    background-blend-mode: difference;
    animation: static-drift 0.2s infinite alternate;
  }
  .screen-scroll {
    container: screen / inline-size;
    position: relative;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    border-radius: 18px;
    overscroll-behavior: contain;
  }
  .screen-scroll::-webkit-scrollbar {
    width: 8px;
  }
  .screen-scroll::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
  }
  .screen-scroll::-webkit-scrollbar-thumb {
    background: var(--orange);
    border-radius: 4px;
    border: 1px solid var(--ink);
  }
  .screen-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--orange-light);
  }

  /* ------------------------------------------------------------------ */
  /* Controls panel                                                      */
  /* ------------------------------------------------------------------ */
  .controls {
    position: relative;
    z-index: 1;
    font-size: 1.25cqi;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4em;
    padding: 0.6em;
    background-color: var(--orange-light);
    border: 2px solid var(--ink);
    border-radius: 20px;
  }

  .knob {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 5em;
    height: 5em;
    border-radius: 50%;
    background-color: var(--wood);
    border: 2px solid #000;
    box-shadow:
      inset 4px 4px 2px var(--wood-light),
      -4px 0 var(--wood-dark),
      -4px 0 0 1px #000;
  }
  .knob-indicator {
    position: absolute;
    inset: 0;
    transform: rotate(var(--angle));
    transition: transform 0.5s ease;
  }
  .knob-indicator::before {
    content: "";
    position: absolute;
    top: 2%;
    bottom: 2%;
    left: calc(50% - 0.095em);
    width: 0.19em;
    background: #000;
  }
  .knob-indicator::after {
    content: "";
    position: absolute;
    top: 55%;
    left: calc(50% + 0.45em);
    width: 0.15em;
    height: 1.6em;
    border-radius: 5px;
    background: #000;
  }
  .channel-knob {
    cursor: pointer;
    transition: filter 0.2s;
  }
  .channel-knob:hover {
    filter: brightness(1.12);
  }
  .controls a:focus-visible {
    outline: 3px solid #fefae0;
    outline-offset: 4px;
  }

  .speakers {
    display: flex;
    flex-direction: column;
    row-gap: 0.5em;
  }
  .dots {
    display: flex;
    column-gap: 0.3em;
  }
  .dots span {
    width: 1.4em;
    height: 1.4em;
    border-radius: 50%;
    background-color: var(--wood);
    border: 2px solid #000;
    box-shadow: inset 1.5px 1.5px 1px var(--wood-light);
  }
  .bar {
    height: 2px;
    background-color: #171717;
  }

  /* pocket-only parts */
  .pocket-btn,
  .brand,
  .lcd,
  .power-switch,
  .wheel {
    display: none;
  }

  .vents {
    position: absolute;
    bottom: 0;
    right: 18cqi;
    display: flex;
    align-items: flex-end;
    column-gap: 0.3em;
  }
  .vents span {
    width: 3.5px;
    height: 20px;
    background-color: #000;
    border-radius: 25px 25px 0 0;
  }
  .vents span:nth-child(2) {
    height: 1.6em;
  }

  .legs {
    position: absolute;
    top: 100%;
    left: 8%;
    right: 8%;
    display: flex;
    justify-content: space-between;
  }
  .legs span {
    width: 3rem;
    height: 1.75rem;
    margin-top: -2px;
    border: 2px solid #171717;
    background-color: #4d4d4d;
  }

  /* Short landscape screens (phones on their side): drop antenna and legs */
  @media (max-height: 500px) and (orientation: landscape) {
    .stage {
      padding: 0.75rem;
    }
    .tv {
      width: min(94vw, calc((100dvh - 1.5rem) * 1.6));
    }
    .antenna,
    .legs {
      display: none;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Pocket TV: phones in portrait                                       */
  /* ------------------------------------------------------------------ */
  @media (max-width: 767px) and (orientation: portrait) {
    .stage {
      padding: 5rem 0.75rem 0.75rem;
    }
    .tv {
      width: min(100%, 30rem);
      height: 100%;
      aspect-ratio: auto;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      gap: 4cqi;
      padding: 5cqi;
      border-radius: 28px;
      box-shadow: inset 2.5cqi 2.5cqi var(--orange-light);
    }
    .curve {
      top: 2.5cqi;
      left: 2.5cqi;
      width: 3cqi;
      height: 3cqi;
    }
    .screen-frame,
    .screen {
      border-radius: 16px;
    }
    .screen-scroll {
      border-radius: 14px;
    }

    /* telescopic antenna from the top-right corner */
    .antenna {
      left: auto;
      right: 14%;
      width: 1rem;
      height: 5rem;
      transform: none;
    }
    .dome,
    .rod-left {
      display: none;
    }
    .rod-right {
      bottom: -2px;
      left: 0;
      width: 5px;
      height: 4.8rem;
      background: linear-gradient(#171717 0 35%, #353535 35% 70%, #555 70%);
      transform: rotate(16deg);
    }

    /* dark bezel around the small screen */
    .screen-frame {
      padding: 2.2cqi;
      background: #2b1a0d;
      border: 2px solid var(--ink);
      border-radius: 18px;
      box-shadow:
        inset 0 0 0 2px #4a2e17,
        3px 3px 0 var(--orange-light);
    }
    .screen {
      border-radius: 12px;
    }
    .screen-scroll {
      border-radius: 10px;
    }

    /* ribbed thumb wheels peeking out of the sides (tuning + volume) */
    .wheel {
      display: block;
      position: absolute;
      top: 34%;
      width: 9px;
      height: 15%;
      border: 2px solid var(--ink);
      background: repeating-linear-gradient(
        var(--wood) 0 3px,
        var(--wood-dark) 3px 5px
      );
    }
    .wheel-left {
      left: -9px;
      border-right: none;
      border-radius: 6px 0 0 6px;
    }
    .wheel-right {
      right: -9px;
      top: 48%;
      border-left: none;
      border-radius: 0 6px 6px 0;
    }

    .controls {
      font-size: 3.6cqi;
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        "brand brand brand"
        "prev lcd next"
        "power . grille";
      align-items: center;
      row-gap: 0.9em;
      column-gap: 0.9em;
      padding: 0.9em 1.1em 1.1em;
      border-radius: 18px;
    }
    .channel-knob,
    .volume-knob,
    .vents,
    .legs {
      display: none;
    }

    .brand {
      grid-area: brand;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding-bottom: 0.5em;
      border-bottom: 2px solid var(--ink);
      color: var(--ink);
    }
    .brand-name {
      font-family: "DM Sans", sans-serif;
      font-size: 1.25em;
      font-weight: 700;
      font-style: italic;
      letter-spacing: 0.04em;
    }
    .brand-sub {
      font-family: "Space Mono", monospace;
      font-size: 0.6em;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* channel readout */
    .lcd {
      grid-area: lcd;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 0;
      height: 3.2em;
      margin: 0;
      padding: 0 0.6em;
      overflow: hidden;
      font-family: VT323, monospace;
      line-height: 1;
      text-transform: uppercase;
      color: #9dff8a;
      text-shadow: 0 0 6px #4cff3a99;
      background: #142012;
      border: 2px solid var(--ink);
      border-radius: 8px;
      box-shadow: inset 0 2px 6px #000;
    }
    .lcd-channel {
      font-size: 1.5em;
    }
    .lcd-title {
      max-width: 100%;
      font-size: 1.1em;
      letter-spacing: 0.1em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0.85;
    }

    .pocket-btn {
      display: grid;
      place-items: center;
      width: 3.6em;
      height: 3.2em;
      color: #fefae0;
      font-size: 1em;
      text-decoration: none;
      border-radius: 12px;
      background-color: var(--wood);
      border: 2px solid #000;
      box-shadow:
        inset 3px 3px 0 var(--wood-light),
        0 4px 0 #000;
      transition: transform 0.08s, box-shadow 0.08s;
    }
    .pocket-btn span {
      font-size: 1.3em;
    }
    .pocket-btn:active {
      transform: translateY(3px);
      box-shadow:
        inset 3px 3px 0 var(--wood-light),
        0 1px 0 #000;
    }
    .prev {
      grid-area: prev;
    }
    .next {
      grid-area: next;
    }

    /* slide power switch (visual only until the power button task) */
    .power-switch {
      grid-area: power;
      display: flex;
      flex-direction: column;
      gap: 0.25em;
    }
    .switch-labels {
      display: flex;
      justify-content: space-between;
      font-family: "Space Mono", monospace;
      font-size: 0.6em;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--ink);
    }
    .switch-track {
      position: relative;
      width: 3.6em;
      height: 1.5em;
      background: #2b1a0d;
      border: 2px solid var(--ink);
      border-radius: 1em;
      box-shadow: inset 0 2px 3px #000;
    }
    .switch-thumb {
      position: absolute;
      top: 0.12em;
      right: 0.15em;
      width: 1.6em;
      height: 1em;
      border-radius: 0.6em;
      background: #c0392b;
      border: 2px solid #000;
      box-shadow: inset 2px 2px 0 #e8806f;
    }

    /* round speaker with a hole grid */
    .speakers {
      grid-area: grille;
      width: 4.4em;
      height: 4.4em;
      border-radius: 50%;
      border: 2px solid var(--ink);
      background:
        radial-gradient(circle, var(--ink) 34%, transparent 38%) center / 0.62em 0.62em,
        #d98a2e;
      box-shadow:
        inset 3px 3px 0 #f2b465,
        2px 2px 0 var(--wood-dark);
    }
    .speakers > * {
      display: none;
    }
  }
</style>
<script>
  // Failsafe: if GSAP animations don't run within 2s, force content visible
  document.addEventListener("astro:page-load", () => {
    const content = document.querySelector(".content") as HTMLElement;
    if (!content) return;

    const failsafe = setTimeout(() => {
      content.style.opacity = "1";
      content.style.transform = "none";
      content.style.filter = "none";
    }, 2000);

    // GSAP scripts can clear this via the global
    (window as any).__gsapFailsafe = failsafe;
  });
</script>
